# ============================================================
# 🛡️ CRYSTAL HEIMDALL 2.0 — ENVIRONMENT CONFIGURATION 🛡️
# ============================================================

# ------------------------------------------------------------
# 1. DATABASE CONFIGURATION (TURSO / LIBSQL / LOCAL SQLITE)
# ------------------------------------------------------------
# For production on Vercel or cloud deployments, create a free database at https://turso.tech
# Retrieve your connection credentials with the Turso CLI:
#   turso db show --url <your-db-name>
#   turso db tokens create <your-db-name>
#
# Once configured, apply database migrations directly with:
#   npm run db:turso
#
# Supported URL aliases: TURSO_DATABASE_URL, TURSO_DB_URL, LIBSQL_URL, DATABASE_URL
# Supported Token aliases: TURSO_AUTH_TOKEN, TURSO_TOKEN, LIBSQL_AUTH_TOKEN
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-jwt

# Optional local data directory (used when TURSO_DATABASE_URL is left blank)
# DATA_DIR=./data

# ------------------------------------------------------------
# 2. EMERGENCY NOTIFICATION CONDUITS (OPTIONAL)
# ------------------------------------------------------------
# Notification channels can also be tested and saved dynamically via the
# Operator Settings UI ([04] DISPATCH tab).
#
# A. Discord Relay (Rich embeds with status, latency & incident traces)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# B. Telegram Bot (Instant real-time mobile push notifications)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWxyz
TELEGRAM_CHAT_ID=-1001234567890

# C. Generic Webhook (JSON payload sent to custom monitoring/Slack endpoints)
GENERIC_WEBHOOK_URL=https://hooks.slack.com/services/...

# ------------------------------------------------------------
# 3. CRON & SYNTHETIC TELEMETRY PROBING
# ------------------------------------------------------------
# Bearer token to protect /api/v1/telemetry/poll when invoked from Vercel Cron or GitHub Actions
CRON_SECRET=your-random-cron-secret-token

# Primary application deployment URL (used for SVG badge links & syndication feeds)
HEIMDALL_APP_URL=https://crystal-heimdall.vercel.app

# ------------------------------------------------------------
# 4. OPERATOR AUTHENTICATION & SECURITY (2FA-ONLY GATE)
# ------------------------------------------------------------
# TOTP_SECRET: Base32 secret for Time-based One-Time Password verification (RFC 6238)
# If left blank, will be automatically generated and persisted in the database upon initial setup.
TOTP_SECRET=

# JWT_SECRET: High-entropy signing key for 30-day operator session tokens (minimum 32 characters)
JWT_SECRET=your-secure-jwt-random-secret-key-32-chars

# ------------------------------------------------------------
# 5. SERVER RUNTIME SETTINGS
# ------------------------------------------------------------
PORT=3030
NODE_ENV=development
