# ============================================================
# CRYSTAL-HEIMDALL CONFIGURATION
# ============================================================

# Database (Leave blank for local SQLite file in ./data/heimdall.db)
# For production on Vercel, create a free database at https://turso.tech
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Notification Channels (Configure in UI or set here)
# 1. Discord Webhook (Rich Embeds with status colors)
DISCORD_WEBHOOK_URL=

# 2. Telegram Bot (Instant free mobile push)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Secret to protect synthetic polling endpoint
CRON_SECRET=
